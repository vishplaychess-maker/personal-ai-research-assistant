# ══════════════════════════════════════════════════════════════════════
# Production environment template — Phase 5 (Cloud Deployment)
# ══════════════════════════════════════════════════════════════════════
# Copy to a secret store (Render env vars / Vercel env vars / .env on a
# VM) and fill in real values. NEVER commit real secrets to git.
# Every value below is a safe placeholder — replace anything marked TODO.

# ── Database (REQUIRED) ────────────────────────────────────────────────
# TODO: set your Render PostgreSQL DATABASE_URL (Internal Connection String).
# Render hands out a legacy "postgres://..." URL; the backend normalizes it
# to "postgresql://..." automatically. Example shape (NOT a real credential):
#   postgresql://research_user:PASSWORD@your-host.render.com:5432/research_ai
# On first deploy the backend runs Base.metadata.create_all() — a FRESH
# database only. Historical SQLite migrations are skipped on PostgreSQL.
DATABASE_URL=

# ── CORS / Frontend origin (REQUIRED) ──────────────────────────────────
# TODO: comma-separated browser origins allowed to call the API with
# credentials. Never use "*". Example:
#   https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=
# Single origin fallback used when CORS_ORIGINS is empty.
# TODO: set to your Vercel production URL.
FRONTEND_ORIGIN=

# ── Auth / security (REQUIRED) ─────────────────────────────────────────
# TODO: strong random secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Refuse to boot with default/insecure settings when true.
PRODUCTION_MODE=true
# Cookies require HTTPS in the cloud.
COOKIE_SECURE=true
# Fernet key encrypting provider API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── LLM provider (GLM default + fallback chain) ────────────────────────
# The GLM Free Router is HOST-LOCAL (default base URL 127.0.0.1:8320/v1) —
# it does NOT exist on a cloud host. Two options:
#   1. TODO: set GLM_BASE_URL to a cloud GLM-compatible endpoint you run.
#   2. Leave it unset and rely on the provider fallback chain
#      (GLM -> free provider -> Ollama); configure at least one cloud
#      provider key below so fallbacks have something to land on.
LLM_PROVIDER=glm
GLM_BASE_URL=
GLM_MODEL=glm-5.3-flash
# Optional GLM/Verdent keys (the GLM provider also honours VERDENT_API_KEY).
GLM_API_KEY=
VERDENT_API_KEY=
# At least one cloud fallback provider is recommended in production.
OPENROUTER_API_KEY=

# ── Optional services ──────────────────────────────────────────────────
# ChromaDB and Ollama are local-dev services; in the cloud /api/health
# will simply report them as "unavailable" (acceptable).
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# ── Feature switches ───────────────────────────────────────────────────
ENABLE_MULTI_AGENT=true
ENABLE_DEEP_RESEARCH=true
DEEP_RESEARCH_MAX_RESULTS=5
DEEP_RESEARCH_MAX_SCRAPE=3
ENABLE_TERMINAL_TOOL=false
ENABLE_MCP_TOOL=false
ENABLE_MEMORY=true
MEMORY_MAX_RESULTS=5

# ── Logging ────────────────────────────────────────────────────────────
# "json" for structured cloud log drains; "text" keeps the default format.
LOG_FORMAT=json
