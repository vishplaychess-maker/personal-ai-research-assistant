# Thunder AI frontend — production API base URL.
#
# Render injects VITE_API_BASE_URL automatically via service discovery
# (render.yaml -> fromService -> thunder-ai-backend RENDER_EXTERNAL_URL), so
# this file is NOT needed for the Render deploy. It is a template for a local
# production build (or another host) where service discovery is unavailable.
#
# Copy to frontend/.env.production (git-ignored) and adjust the origin.
VITE_API_BASE_URL=https://thunder-ai-backend.onrender.com
