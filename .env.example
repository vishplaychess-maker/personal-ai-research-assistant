# ── Backend ───────────────────────────────────
DATABASE_URL=sqlite:////data/app.db
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# ── Memory (Phase 4) ──────────────────────────
# ENABLE_MEMORY is the config default when NO database row exists yet.
# Once the user toggles memory via the UI or PATCH /api/settings/memory,
# the value is persisted in the app_settings SQLite table and survives
# Docker restarts. The toggle takes effect immediately from both the
# frontend and backend perspective.
ENABLE_MEMORY=true
MEMORY_MAX_RESULTS=5

# ── Auth (Phase 6A) ───────────────────────────
# JWT_SECRET is used to sign and verify JWT tokens.
# ⚠️ PLACEHOLDER ONLY — do NOT put a real secret in this file or any
# version-controlled file. Production requires a strong, randomly generated
# secret (at least 256 bits). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and export it as JWT_SECRET in your deployment environment. If unset,
# the insecure default 'change-me-in-production' is used with a warning,
# and the app refuses to start in PRODUCTION_MODE=true.
# Leave JWT_SECRET unset in this template.
JWT_SECRET=

# ── Rate Limiting (Phase 7A) ───────────────────
# Maximum number of authentication attempts per time window (per IP).
RATE_LIMIT_MAX_ATTEMPTS=10
# Time window in seconds for rate limiting.
RATE_LIMIT_WINDOW_SECONDS=60
# Consecutive failed login attempts before account lockout.
RATE_LIMIT_LOCKOUT_THRESHOLD=5
# Base lockout duration in seconds (doubles with each subsequent lockout).
RATE_LIMIT_LOCKOUT_BASE_SECONDS=30
# Maximum lockout duration in seconds (capped at 15 minutes).
RATE_LIMIT_LOCKOUT_MAX_SECONDS=900
# Set to true in production to enforce JWT secret strength.
PRODUCTION_MODE=false

# 🔄 Phase 7B: Refresh Tokens & Session Management
# Access token lifetime in minutes (default: 15).
JWT_ACCESS_EXPIRY_MINUTES=15
# Refresh token lifetime in days (default: 30).
JWT_REFRESH_EXPIRY_DAYS=30
# Maximum concurrent active sessions per user (default: 10).
MAX_ACTIVE_SESSIONS=10
# Refresh endpoint rate limit: max requests per window per IP.
REFRESH_RATE_LIMIT_REQUESTS=20
# Refresh endpoint rate limit: window in seconds.
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
# 🍪 Phase 7C: HttpOnly Refresh Cookie & CSRF Protection
# Name of the HttpOnly cookie that carries the refresh token (set by the
# backend on login/refresh; never exposed to JavaScript).
REFRESH_COOKIE_NAME=research_assistant_refresh_token
# Name of the non-HttpOnly cookie used for double-submit CSRF.
CSRF_COOKIE_NAME=research_assistant_csrf_token
# Secure flag for both cookies. MUST be true in production (HTTPS required).
# false is only acceptable for localhost development.
COOKIE_SECURE=false
# SameSite attribute for the refresh cookie. lax is the recommended default
# for local development; production may prefer strict or none (with
# Secure=true and HTTPS) depending on the deployment topology.
COOKIE_SAMESITE=lax
# Exact frontend origin allowed by CORS (with credentials). Never use a
# wildcard when credentials are enabled. Must match the deployed frontend.
FRONTEND_ORIGIN=http://localhost:5173

# ── Production notes (Phase 7C) ─────────────────────────────────────
# 1. Set COOKIE_SECURE=true — cookies will only be sent over HTTPS.
# 2. HTTPS is REQUIRED in production for secure cookie delivery.
# 3. Set a strong JWT_SECRET (see the JWT_SECRET section above).
# 4. FRONTEND_ORIGIN must be set to the EXACT deployed frontend origin
#    (scheme + host + port), e.g. https://app.example.com.
# 5. Keep SameSite=Lax (or stricter) unless you run API and frontend on
#    different sites and deliberately enable cross-site cookies.
