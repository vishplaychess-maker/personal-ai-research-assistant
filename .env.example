# ── Backend ───────────────────────────────────
DATABASE_URL=sqlite:////data/app.db
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# ── Memory (Phase 4) ──────────────────────────
# ENABLE_MEMORY is the config default when NO database row exists yet.
# Once the user toggles memory via the UI or PATCH /api/settings/memory,
# the value is persisted in the app_settings SQLite table and survives
# Docker restarts. The toggle takes effect immediately from both the
# frontend and backend perspective.
ENABLE_MEMORY=true
MEMORY_MAX_RESULTS=5

# ── Auth (Phase 6A) ───────────────────────────
# JWT_SECRET is used to sign and verify JWT tokens.
# ⚠️ PLACEHOLDER ONLY — do NOT put a real secret in this file or any
# version-controlled file. Production requires a strong, randomly generated
# secret (at least 256 bits). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and export it as JWT_SECRET in your deployment environment. If unset,
# the insecure default 'change-me-in-production' is used with a warning,
# and the app refuses to start in PRODUCTION_MODE=true.
# Leave JWT_SECRET unset in this template.
JWT_SECRET=

# ── Rate Limiting (Phase 7A) ───────────────────
# Maximum number of authentication attempts per time window (per IP).
RATE_LIMIT_MAX_ATTEMPTS=10
# Time window in seconds for rate limiting.
RATE_LIMIT_WINDOW_SECONDS=60
# Consecutive failed login attempts before account lockout.
RATE_LIMIT_LOCKOUT_THRESHOLD=5
# Base lockout duration in seconds (doubles with each subsequent lockout).
RATE_LIMIT_LOCKOUT_BASE_SECONDS=30
# Maximum lockout duration in seconds (capped at 15 minutes).
RATE_LIMIT_LOCKOUT_MAX_SECONDS=900
# Set to true in production to enforce JWT secret strength.
PRODUCTION_MODE=false

# 🔄 Phase 7B: Refresh Tokens & Session Management
# Access token lifetime in minutes (default: 15).
JWT_ACCESS_EXPIRY_MINUTES=15
# Refresh token lifetime in days (default: 30).
JWT_REFRESH_EXPIRY_DAYS=30
# Maximum concurrent active sessions per user (default: 10).
MAX_ACTIVE_SESSIONS=10
# Refresh endpoint rate limit: max requests per window per IP.
REFRESH_RATE_LIMIT_REQUESTS=20
# Refresh endpoint rate limit: window in seconds.
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
# 🍪 Phase 7C: HttpOnly Refresh Cookie & CSRF Protection
# Name of the HttpOnly cookie that carries the refresh token (set by the
# backend on login/refresh; never exposed to JavaScript).
REFRESH_COOKIE_NAME=research_assistant_refresh_token
# Name of the non-HttpOnly cookie used for double-submit CSRF.
CSRF_COOKIE_NAME=research_assistant_csrf_token
# Secure flag for both cookies. MUST be true in production (HTTPS required).
# false is only acceptable for localhost development.
COOKIE_SECURE=false
# SameSite attribute for the refresh cookie. lax is the recommended default
# for local development; production may prefer strict or none (with
# Secure=true and HTTPS) depending on the deployment topology.
COOKIE_SAMESITE=lax
# Exact frontend origin allowed by CORS (with credentials). Never use a
# wildcard when credentials are enabled. Must match the deployed frontend.
FRONTEND_ORIGIN=http://localhost:5173

# ── Terminal Tool (Phase 9 — Agent Tools) ─────────────────────────
# Enable the terminal executor tool. When true, the AI agent can propose
# shell commands for your approval before execution (human-in-the-loop).
ENABLE_TERMINAL_TOOL=false

# ── LLM Provider (Phase 8 — Multi-Provider) ────────────────────────
# Which LLM provider to use for chat/generation.
# Options: ollama (local), openrouter (free cloud models), nvidia (NVIDIA NIM)
LLM_PROVIDER=ollama

# ── Secrets Encryption at Rest (Security Overhaul) ─────────────────
# ENCRYPTION_KEY is the Fernet key (URL-safe base64, 32 bytes) used to encrypt
# API keys before they are written to the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the backend generates an EPHEMERAL key per process and logs a loud
# warning — secrets encrypted under it become unrecoverable after restart.
# Leave unset in this template; set a real value in your deployment.
ENCRYPTION_KEY=

# ── OpenRouter (free cloud models) ─────────────────────────────────
# Get your API key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_MAX_TOKENS=2048
# OPENROUTER_TEMPERATURE=0.7

# ── NVIDIA NIM (free cloud models) ─────────────────────────────────
# Get your API key at https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_MAX_TOKENS=2048
# NVIDIA_TEMPERATURE=0.7

# ── Hugging Face (free serverless models) ──────────────────────────────
# Get your token at https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# HUGGINGFACE_MAX_TOKENS=2048
# HUGGINGFACE_TEMPERATURE=0.7

# ── Google AI Studio / Gemini (free tier) ──────────────────
# Get your key at https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
*** GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GOOGLE_MODEL=gemini-2.0-flash
# GOOGLE_MAX_TOKENS=2048
# GOOGLE_TEMPERATURE=0.7

# ── ModelsLab (OpenAI-compatible - assumed) ───────────────────
# Get your key at https://modelslab.com/
# MODELSLAB_API_KEY=
*** MODELSLAB_BASE_URL=https://modelslab.com/api/v1
# MODELSLAB_MODEL=meta-llama/Llama-3.3-70B-Instruct
# MODELSLAB_MAX_TOKENS=2048
# MODELSLAB_TEMPERATURE=0.7

# ── Groq (free cloud models) ─────────────────────────────────
# Get your key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=2048
# GROQ_TEMPERATURE=0.7

# ── Together AI (free cloud models) ──────────────────────────
# Get your key at https://api.together.ai/settings/api-keys
# TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
# TOGETHER_MAX_TOKENS=2048
# TOGETHER_TEMPERATURE=0.7

# ── Mistral (free cloud models) ──────────────────────────────
# Get your key at https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_MAX_TOKENS=2048
# MISTRAL_TEMPERATURE=0.7

# ── Cohere (free cloud models) ───────────────────────────────
# Get your key at https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=
# COHERE_BASE_URL=https://api.cohere.ai/v1
# COHERE_MODEL=command-r-plus
# COHERE_MAX_TOKENS=2048
# COHERE_TEMPERATURE=0.7

# ── Deep Research (web search via DuckDuckGo — free, no API key) ──
# Enables autonomous web search + scrape + synthesize ("Deep Research Mode").
# Uses DuckDuckGo — 100% free, no API key required.
DEEP_RESEARCH_MAX_RESULTS=5
# How many top results to scrape per pass (default: 3). Hard cap that bounds
# the search -> scrape -> synthesize loop so it can never spin forever.
DEEP_RESEARCH_MAX_SCRAPE=3
# Master switch. Set to false to disable deep research entirely.
ENABLE_DEEP_RESEARCH=true

# ── Agent Skills (SKILL.md, progressive disclosure) ─────────
# Directory containing one folder per skill, each with a SKILL.md file.
# Optional; defaults to backend/app/skills.
# SKILLS_DIR=/path/to/skills

# ── Production notes (Phase 7C) ─────────────────────────────────────
# 1. Set COOKIE_SECURE=true — cookies will only be sent over HTTPS.
# 2. HTTPS is REQUIRED in production for secure cookie delivery.
# 3. Set a strong JWT_SECRET (see the JWT_SECRET section above).
# 4. FRONTEND_ORIGIN must be set to the EXACT deployed frontend origin
#    (scheme + host + port), e.g. https://app.example.com.
# 5. Keep SameSite=Lax (or stricter) unless you run API and frontend on
#    different sites and deliberately enable cross-site cookies.
