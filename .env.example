# ── Backend ───────────────────────────────────
DATABASE_URL=sqlite:////data/app.db
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# ── Memory (Phase 4) ──────────────────────────
# ENABLE_MEMORY is the config default when NO database row exists yet.
# Once the user toggles memory via the UI or PATCH /api/settings/memory,
# the value is persisted in the app_settings SQLite table and survives
# Docker restarts. The toggle takes effect immediately from both the
# frontend and backend perspective.
ENABLE_MEMORY=true
MEMORY_MAX_RESULTS=5

# ── Auth (Phase 6A) ───────────────────────────
# JWT_SECRET is used to sign and verify JWT tokens.
# CHANGE THIS in production — use a 256-bit random key.
# If not set, the default 'change-me-in-production' is used with a warning.
JWT_SECRET=

# ── Rate Limiting (Phase 7A) ───────────────────
# Maximum number of authentication attempts per time window (per IP).
RATE_LIMIT_MAX_ATTEMPTS=10
# Time window in seconds for rate limiting.
RATE_LIMIT_WINDOW_SECONDS=60
# Consecutive failed login attempts before account lockout.
RATE_LIMIT_LOCKOUT_THRESHOLD=5
# Base lockout duration in seconds (doubles with each subsequent lockout).
RATE_LIMIT_LOCKOUT_BASE_SECONDS=30
# Maximum lockout duration in seconds (capped at 15 minutes).
RATE_LIMIT_LOCKOUT_MAX_SECONDS=900
# Set to true in production to enforce JWT secret strength.
PRODUCTION_MODE=false

# 🔄 Phase 7B: Refresh Tokens & Session Management
# Access token lifetime in minutes (default: 15).
JWT_ACCESS_EXPIRY_MINUTES=15
# Refresh token lifetime in days (default: 30).
JWT_REFRESH_EXPIRY_DAYS=30
# Maximum concurrent active sessions per user (default: 10).
MAX_ACTIVE_SESSIONS=10
# Refresh endpoint rate limit: max attempts per window per IP.
REFRESH_RATE_LIMIT_MAX_ATTEMPTS=20
# Refresh endpoint rate limit: window in seconds.
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
