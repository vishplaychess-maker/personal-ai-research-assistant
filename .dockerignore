.github
.venv
.tmp
.pytest_cache
.superpowers
node_modules
frontend
# backend/ stays out of the executor context EXCEPT the shared contract.
backend/*
!backend/mp4c_contract
evals
docs
secrets
*.db
test.db
build_output.txt
.env
.env.*
